# =============================================================
#  WHAT THIS FILE DOES:
#  It creates ONE network that containers can share. Any container
#  that joins it (with Network=cert-bot.network in its .container file)
#  can reach the others BY THEIR CONTAINER NAME — like a phone book.
#  Example: Caddy can talk to http://mattermost:8065 with no IP needed.
#
#  Make ONE of these per stack. Not one per app.
#  Rootless live location:  ~/.config/containers/systemd/
#  After adding/changing it: systemctl --user daemon-reload
#
#  Filename MUST be: cert-bot.network
# =============================================================


[Unit]
# A short label so you know what this network is for when you see it later.
Description=Shared network for the certification bot


[Network]
# Leaving this section empty is fine — Podman builds a normal network
# with sensible defaults. Only add options below if you have a reason to.

# Give the network a fixed name instead of an auto-generated one.
NetworkName=cert-bot

# Pick your own IP range (only if the default clashes with your LAN).
# Subnet=10.89.0.0/24
# Gateway=10.89.0.1

[Install]
# A network has nothing to "start" on its own, so this usually does nothing.
# A container that joins the network pulls it up automatically.
# Left here only as a reference.
WantedBy=default.target
